<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="viewModel"
            type="com.example.progetto_rosso_iacopo.ui.generation.GenerateRoutineViewModel" />
    </data>
    <androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genera la tua scheda di allenamento"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- OBIETTIVO DELL'ALLENAMENTO (scelta singola) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Obiettivo dell'allenamento"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupObiettivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioIpertrofia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ipertrofia (massa muscolare)" />

                        <RadioButton
                            android:id="@+id/radioForza"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forza" />

                        <RadioButton
                            android:id="@+id/radioDimagrimento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dimagrimento" />

                        <RadioButton
                            android:id="@+id/radioResistenza"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resistenza / condizionamento" />

                        <RadioButton
                            android:id="@+id/radioTonificazione"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tonificazione" />

                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LIVELLO DI ESPERIENZA (scelta singola) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Livello di esperienza"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/radioGroupLivello"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioPrincipiante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Principiante" />

                    <RadioButton
                        android:id="@+id/radioIntermedio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intermedio" />

                    <RadioButton
                        android:id="@+id/radioAvanzato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avanzato" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- ATTREZZATURA DISPONIBILE (scelta multipla) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attrezzatura disponibile"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puoi selezionare più di un'opzione"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/layoutAttrezzatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/checkCorpoLibero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Corpo libero" />

                    <CheckBox
                        android:id="@+id/checkManubri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manubri" />

                    <CheckBox
                        android:id="@+id/checkBilanciere"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilanciere" />

                    <CheckBox
                        android:id="@+id/checkMacchine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Macchine da palestra" />

                    <CheckBox
                        android:id="@+id/checkElastici"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elastici / bande di resistenza" />

                    <CheckBox
                        android:id="@+id/checkKettlebell"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kettlebell" />

                    <CheckBox
                        android:id="@+id/checkPalestraCompleta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Palestra completamente attrezzata" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- LIMITAZIONI FISICHE (scelta multipla) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhysicalLimitation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limitazioni fisiche o problemi"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puoi selezionare più di un'opzione"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/layoutLimitazioni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/checkNessunaLimitazione"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nessuna limitazione" />

                    <CheckBox
                        android:id="@+id/checkGinocchio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Problemi al ginocchio" />

                    <CheckBox
                        android:id="@+id/checkSchiena"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Problemi alla schiena / lombalgia" />

                    <CheckBox
                        android:id="@+id/checkSpalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Problemi alla spalla" />

                    <CheckBox
                        android:id="@+id/checkAnca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Problemi all'anca" />

                    <CheckBox
                        android:id="@+id/checkCardiovascolare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limitazioni cardiovascolari" />

                    <CheckBox
                        android:id="@+id/checkAltraLimitazione"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Altro (specifica nelle richieste addizionali)" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- RICHIESTE ADDIZIONALI (testo libero) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdditionalRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Richieste addizionali"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editRichiesteAddizionali"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Es: preferisco esercizi in superset, ho 45 minuti a disposizione..."
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:maxLines="6" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- PULSANTE GENERA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGeneraScheda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="Genera scheda" />

            <ProgressBar
                android:id="@+id/progressBarGenerazione"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>